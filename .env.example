# OyaEat API base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://api.oyaeat.com.ng

# Approved public frontend origin used for Paystack callbacks. Leave unset for
# local development, where the current browser origin is used.
NEXT_PUBLIC_APP_ORIGIN=https://your-approved-frontend-origin.example

# Google Identity Services OAuth 2.0 Web client ID. This identifier is public;
# do not put a client secret or service-account credentials in this file.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Existing Google Maps configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here
NEXT_PUBLIC_MAP_ID=DEMO_MAP_ID
